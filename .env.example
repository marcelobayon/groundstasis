# =============================================================================
# Ground Stasis — environment variables
# Copy to `.env.local` for development. NEVER commit real secrets.
# The app runs fully in DEMO MODE with none of these set.
# =============================================================================

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (optional for demo; required for real sites) -------------------
# Postgres connection string. Neon and Supabase both have free tiers.
# For geometry you can start with GeoJSON stored as JSON; upgrade to PostGIS later.
DATABASE_URL="postgresql://user:password@host:5432/groundstasis?sslmode=require"

# --- Satellite provider ------------------------------------------------------
# "demo" (default, no keys) or "sentinelhub" (Copernicus Data Space Ecosystem).
SATELLITE_PROVIDER="demo"

# Copernicus Data Space Ecosystem (CDSE) OAuth client credentials.
# Register at https://dataspace.copernicus.eu -> Dashboard -> User Settings -> OAuth clients.
# These two together are your "SATELLITE_PROVIDER_API_KEY".
SENTINELHUB_CLIENT_ID=""
SENTINELHUB_CLIENT_SECRET=""
# Base host + token endpoint (defaults target CDSE; override for commercial Sentinel Hub).
SENTINELHUB_BASE_URL="https://sh.dataspace.copernicus.eu"
SENTINELHUB_TOKEN_URL="https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token"

# --- Billing (Stripe) --------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""              # price for $19/site/month
STRIPE_PUBLISHABLE_KEY=""       # (optional, client-side checkout redirect)

# --- Email (transactional) ---------------------------------------------------
# "console" (default, logs to server console) | "resend" | "postmark" | "sendgrid"
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="alerts@groundstasis.com"

# --- Auth (magic links) ------------------------------------------------------
# Secret(s) used to sign magic-link tokens. Generate with: openssl rand -hex 32
MAGIC_LINK_SECRET="change-me-in-production-openssl-rand-hex-32"
# During key rotation, the previous secret still verifies existing links.
MAGIC_LINK_SECRET_PREVIOUS=""
MAGIC_LINK_TTL_MINUTES="30"

# --- Admin / debug -----------------------------------------------------------
# Protects /admin and POST /api/analyze. Generate with: openssl rand -hex 32
ADMIN_SECRET="change-me-admin-secret"

# --- Analytics ---------------------------------------------------------------
# Public GA4 measurement ID (safe to expose client-side).
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-F1R30MC86L"

# Server-only GA4 Measurement Protocol secret for the verified `purchase` event (Decision D).
# GA4 Admin -> Data Streams -> (your web stream) -> Measurement Protocol API secrets -> Create.
# NEVER prefix with NEXT_PUBLIC and never expose client-side. Set the real value in Netlify env.
GA4_API_SECRET=""
